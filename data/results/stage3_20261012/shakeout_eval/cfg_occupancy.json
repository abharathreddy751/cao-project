{
 "seed": 0,
 "require_decision_context": true,
 "allow_profile_after_sessions": false,
 "mape_floor_s": 0.5,
 "measure_memory": true,
 "e3_window": 8,
 "rc": {
  "alpha": 0.2,
  "min_obs": 1,
  "clamp": [
   0.5,
   3.0
  ]
 },
 "ridge": {
  "ridge_lambda": 1.0,
  "min_rows": 30,
  "feature_set": "occupancy+history"
 },
 "catboost": {
  "iterations": 20,
  "depth": 3,
  "learning_rate": 0.3
 },
 "mlp": {
  "hidden": [
   8
  ],
  "epochs": 3,
  "lr": 0.01,
  "weight_decay": 0.0,
  "batch_size": 64
 },
 "latency": {
  "n_calls": 50
 },
 "selection": {
  "margin": 0.0
 },
 "split": {
  "policy": "occupancy",
  "threshold": 4
 }
}